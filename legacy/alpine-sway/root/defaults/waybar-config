{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["clock", "tray"],
  "sway/workspaces": {
    "disable-scroll": true
  },
  "sway/window": {
    "max-length": 50
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  }
}
