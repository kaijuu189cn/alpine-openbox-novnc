# Copy to .env and edit; docker compose reads it automatically.
#
# Host port for the noVNC web UI. The container always serves on 3000.
# Change this when 3000 is taken by another webtop on the host.
WEB_PORT=3000

# Host directory bound to the container's /home/abc (Wine prefix, Chromium
# profile, desktop config). Defaults to ./abc next to this file.
# CONFIG_DIR=./abc
