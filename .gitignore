# Runtime data of the container: Wine prefix, Chromium profile, desktop config.
# This is the HOST directory (./abc in docker-compose.yml) that is bound to the
# container's /home/abc. It is hundreds of MB and completely reproducible --
# never commit it.
/abc/

# Local compose overrides (see .env.example)
/.env

# Python bytecode left by running the helper scripts
__pycache__/
*.pyc

# Workspace/agent bookkeeping, not part of the image project itself
/对话索引.md
