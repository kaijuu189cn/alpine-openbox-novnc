#!/bin/bash
#
# wine-webtop -- run Windows software on the webtop desktop.
#
# The Openbox menu calls this instead of bare `wine`, because a menu action
# inherits a bare environment and bare `wine` on a brand-new /config volume
# spends ~30s building a prefix (while appearing to do nothing at all).
# This wrapper:
#
#   * pins HOME / DISPLAY / XDG_RUNTIME_DIR, so wine always finds the X server
#     and the /config volume no matter who launched it;
#   * runs wine-prefix-init first when the prefix is missing, so the app gets a
#     ready prefix and the "first click does nothing" failure cannot happen;
#   * keeps WINEDEBUG quiet and suppresses the wine-mono / wine-gecko prompts
#     (Alpine ships no wine-mono / wine-gecko packages).
#
# USAGE (from a terminal on the desktop)
#   wine-webtop                          # Wine file manager (winefile)
#   wine-webtop notepad                  # a Wine builtin
#   wine-webtop winecfg                  # Wine configuration
#   wine-webtop ~/Desktop/setup.exe      # a Windows installer or program
#   wine-webtop 'C:\Program Files\App\App.exe'
#
# 32-bit Windows binaries work too: wine 10.7 on Alpine is built with the new
# WoW64 layout (/usr/lib/wine/i386-windows), so no multilib is needed.
#
set -u

HOME_DIR="${HOME:-/config}"

export WINEPREFIX="${WINEPREFIX:-$HOME_DIR/.wine}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
export DISPLAY="${DISPLAY:-:1}"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME_DIR/.XDG}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Bare `wine-webtop` from a panel/launcher: open the Wine file manager rather
# than printing wine's usage text into nowhere.
if [ "$#" -eq 0 ]; then
  set -- winefile
fi

if [ ! -d "$WINEPREFIX/drive_c/windows" ]; then
  echo "[wine] no prefix yet -- building one in ${WINEPREFIX} (about 30s)..."
  # --headless: build the prefix with no X connection. Wine's process churn
  # during prefix creation makes tint2 segfault, and the panel should not blink
  # just because a prefix is being created. The app itself is then launched
  # normally, below.
  if ! /usr/bin/wine-prefix-init --headless; then
    echo "[wine] prefix init failed; see ${WINEPREFIX%/}.init.log -- trying anyway"
  fi
fi

exec /usr/bin/wine "$@"
