#!/bin/bash
#
# wine-prefix-init -- create (or repair) the user's Wine prefix, exactly once.
#
# WHY THIS IS A SEPARATE SCRIPT
# -----------------------------
# Building a Wine prefix takes roughly 30 seconds (wineboot unpacks the C:
# drive, registers fonts and writes the registry). Two things must not happen:
#
#   1. The desktop must not block on it. The Openbox autostart runs this in the
#      background so the noVNC session is usable immediately.
#   2. Two wineboot processes must never touch the same prefix at once -- that
#      is how prefixes get corrupted. This script takes an exclusive flock, and
#      the wine-webtop launcher goes through this same script, so a menu click
#      that races the background primer simply waits instead of colliding.
#
# It is idempotent: if the prefix already has a windows/ directory it exits 0
# without doing anything.
#
# --headless (USE THIS)
# ---------------------
# Building the prefix does not need a display at all: wineboot unpacks drive_c,
# enumerates fonts through fontconfig and writes the registry without talking to
# X (verified: rc=0 with no DISPLAY, and the resulting prefix runs GUI apps
# fine). Passing --headless unloads winex11.drv, which matters because Wine's
# process churn (services.exe, winedevice.exe, explorer.exe /desktop, ...)
# creates and destroys X windows, and tint2 SEGFAULTS once for each burst of
# that churn:
#
#     WARN exited: tint2 (terminated by SIGSEGV (core dumped); not expected)
#
# With a display, a fresh boot produced 14 tint2 crashes over ~2 minutes before
# the churn settled. Headless: zero. Measured with the same 60s test container.
#
# Output goes to $HOME/.wine-init.log (override with WINE_INIT_LOG).
#
set -u

HOME_DIR="${HOME:-/config}"

# Headless mode: make DISPLAY explicitly EMPTY so winex11.drv never loads and
# no X window is ever created.
#
# Do NOT use `unset DISPLAY` here: the ${DISPLAY-:1} default below only fires
# when DISPLAY is unset, so unsetting it silently brings :1 back -- which is
# exactly the bug that made the first version of this "headless" mode still
# touch X (the panel kept crashing at boot).
HEADLESS=no
if [ "${1:-}" = "--headless" ]; then
  DISPLAY=""
  HEADLESS=yes
fi

export WINEPREFIX="${WINEPREFIX:-$HOME_DIR/.wine}"
export WINEDEBUG="${WINEDEBUG:--all}"
# No wine-mono / wine-gecko exist for Alpine, so suppress the "install Mono?"
# dialog: a Windows app needing .NET then fails visibly instead of hanging.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
# ${DISPLAY-:1}: default only when DISPLAY is unset; an explicitly empty value
# (the headless path) stays empty.
export DISPLAY="${DISPLAY-:1}"

# Wine complains loudly ("XDG_RUNTIME_DIR is invalid or not set") without this.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME_DIR/.XDG}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

LOG="${WINE_INIT_LOG:-$HOME_DIR/.wine-init.log}"

# The prefix lives on the /config volume, which may not be writable (e.g. a
# read-only bind mount). Bail out quietly in that case; wine-webtop reports it.
mkdir -p "$(dirname "$WINEPREFIX")" 2>/dev/null || exit 1

# Serialise against every other prefix builder.
if ! exec 9>"${WINEPREFIX}.lock"; then
  exit 1
fi
flock 9

# Already built (by us, by a previous boot, or by a race winner).
if [ -d "$WINEPREFIX/drive_c/windows" ]; then
  exit 0
fi

{
  echo "[wine-init] $(date '+%Y-%m-%dT%H:%M:%S%z') creating prefix ${WINEPREFIX} (headless=${HEADLESS} DISPLAY='${DISPLAY}')"
  # timeout guards the session: a wedged wineserver must not hold the lock
  # forever and block every later launcher.
  timeout 600 wineboot -u
  rc=$?
  if [ -d "$WINEPREFIX/drive_c/windows" ]; then
    echo "[wine-init] $(date '+%Y-%m-%dT%H:%M:%S%z') prefix ready (wineboot rc=${rc})"
    exit 0
  fi
  echo "[wine-init] $(date '+%Y-%m-%dT%H:%M:%S%z') prefix creation FAILED (wineboot rc=${rc})"
  exit 1
} >>"$LOG" 2>&1
